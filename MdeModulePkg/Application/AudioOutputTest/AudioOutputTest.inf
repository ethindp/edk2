[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = AudioOutputTest
  MODULE_UNI_FILE                = AudioOutputTest.uni
  FILE_GUID                      = C17DC50F-5845-4B4E-88C7-08D5966A6B05
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = AudioOutputTestMain

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 AARCH64 RISCV64 LOONGARCH64
#

[Sources]
  AudioOutputTest.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DevicePathLib
  MemoryAllocationLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  gEdkiiSimpleAudioOutputProtocolGuid    ## CONSUMES
  gEdkiiAudioOutputManagerProtocolGuid   ## SOMETIMES_CONSUMES
  gEfiComponentNameProtocolGuid          ## SOMETIMES_CONSUMES
  gEfiComponentName2ProtocolGuid         ## SOMETIMES_CONSUMES
  gEfiLoadedImageProtocolGuid            ## CONSUMES
  gEfiPciIoProtocolGuid                  ## SOMETIMES_CONSUMES

[UserExtensions.TianoCore."ExtraFiles"]
  AudioOutputTestExtra.uni
